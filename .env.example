# Copy to .env, then edit for your robot. This file contains no credentials.
# IPs below are examples from the original UR5 installation.
ROBOT_IP=10.0.1.38
PC_IP=10.0.1.42
ROBOT_INTERFACE=enp179s0f1
ROS_DOMAIN_ID=0
BASE_CAMERA_SERIAL=REPLACE_WITH_BASE_SERIAL
WRIST_CAMERA_SERIAL=REPLACE_WITH_WRIST_SERIAL
# Optional: absolute path to YOUR extracted factory calibration YAML.
UR_KINEMATICS_FILE=
# Optional: Python 3.12 environment with this repository's LeRobot installed.
# When empty, scripts/env.sh uses REPOSITORY/.venv-vla/bin/python.
VLA_PYTHON=
